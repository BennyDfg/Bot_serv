[TEMPLATE]
# Token del bot de Telegram (BotFather → /newbot → copia el token).
TELEGRAM_BOT_TOKEN=123456789:AAEjemplo...

# Token de la API para las apps: el MISMO valor se escribe en Ajustes de la
# app Android (sección «Agente y servidor» → Token del servidor).
API_TOKEN=cambia-este-token-por-uno-largo

# URL pública del servicio (la que da Railway). Si no se pone, se intenta
# tomar de RAILWAY_PUBLIC_DOMAIN automáticamente.
BASE_URL=https://tu-app.up.railway.app

# Hora del resumen diario automático y zona horaria.
RESUMEN_HORA=22:30
TZ=Europe/Madrid

# Opcional: chat de Telegram donde responde el bot. Si se deja vacío, el
# primer /start en el grupo lo registra automáticamente. En grupos el id es
# negativo (p. ej. -1001234567890).
OWNER_CHAT_ID=

# (Opcional) Cadena aleatoria que Telegram reenvía en cada webhook para
# autenticarlo. Se genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# En producción (Railway): conexión a Postgres.
#   postgresql+psycopg://usuario:clave@host:5432/base_de_datos
# En local se puede dejar vacío y se usa SQLite (data/bot.db).
DATABASE_URL=
